{
    "compilerOptions": {
        "types": ["node"],
        "target": "ES2022",
        "module": "commonjs",
        "lib": ["ES2022", "DOM"],
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,        
        "skipLibCheck": true,
        "ignoreDeprecations": "6.0"
    },
    "include": [
        "**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}